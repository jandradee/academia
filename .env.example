# Pega estos NOMBRES en Coolify > Environment Variables. Nunca subas valores reales a git.
# OBLIGATORIOS (sin ellos la app no arranca en producción, a propósito):
DJANGO_SECRET_KEY=genera-una-clave-larga-aleatoria-de-50-caracteres
DJANGO_ALLOWED_HOSTS=lms.tudominio.com
CSRF_TRUSTED_ORIGINS=https://lms.tudominio.com
# RECOMENDADO al inicio: solo tu IP pública puede entrar (déjalo vacío cuando abras a toda la empresa)
ALLOWED_IPS=
# Opcionales:
CORS_ALLOWED_ORIGINS=
TIME_ZONE=America/El_Salvador
